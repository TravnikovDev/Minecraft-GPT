# OpenAI API key (used for gpt-6-luna tool calling)
OPENAI_API_KEY=your_openai_api_key_here

# Your Minecraft username: the bot only obeys this player's chat
OWNER_USERNAME=YourMinecraftName

# Minecraft bot settings
BOT_USERNAME=MinecraftGPT
SERVER_HOST=localhost
SERVER_PORT=25565

# Login mode: "offline" for servers with online-mode=false,
# "microsoft" to log in with a real Minecraft account
AUTH=offline

# Hard monthly cap on model spending (chat and day plans), in US dollars.
# Past it the bot makes no more model calls until next month.
LLM_MONTHLY_CAP_USD=10
